      "completed": true,
      "task":1
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # PATCH & PUT can be used to remap the relation b/w task and subtasks
  Not that PUT requires all the non-omitable fileds
  (required = not allow_null and not has_default) including the relation
}
