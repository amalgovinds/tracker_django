meta {
  name: LIST All Task Details
  type: http
  seq: 1
}

get {
  url: {{base_url}}/tracker/tasks/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # All are nested read serializers due to which the entire details are given
  
  Append {task_id} at end of url to obtain details about a specific task
}
